<DeliveryActiveScreen>:
    canvas.before:
        Color:
            rgba: color_bg
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        orientation: "vertical"
        padding: [dp(20), dp(20), dp(20), dp(16)]
        spacing: dp(14)

        BoxLayout:
            size_hint_y: None
            height: dp(44)
            spacing: dp(12)

            IconBtn:
                text: "‹"
                on_press: app.open_delivery_dashboard()

            TitleLabel:
                text: "My Deliveries"

        SubLabel:
            text: "Orders you're currently delivering"
            size_hint_y: None
            height: dp(20)

        RecycleView:
            id: rv
            viewclass: 'DeliveryActiveOrderItem'

            RecycleBoxLayout:
                default_size: None, dp(78)
                default_size_hint: 1, None
                size_hint_y: None
                height: self.minimum_height
                spacing: dp(12)
                orientation: 'vertical'


<DeliveryActiveOrderItem@ListCard>:
    accent: color_primary
    spacing: dp(8)

    Label:
        text: root.text
        font_size: 15
        bold: True
        color: color_text
        halign: 'left'
        valign: 'middle'
        text_size: self.size
        padding: [dp(12), 0]

    ActionBtn:
        text: "Complete"
        btn_color: color_success
        size_hint: None, None
        size: dp(96), dp(44)
        font_size: 13
        on_press: app.complete_delivery(root.id)

    GhostBtn:
        text: "Cancel"
        line_color: color_danger
        size_hint: None, None
        size: dp(84), dp(44)
        font_size: 13
        on_press: app.confirm_cancel_delivery(root.id, root.text)
