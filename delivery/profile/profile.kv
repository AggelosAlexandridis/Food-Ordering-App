<DeliveryProfileScreen>:
    canvas.before:
        Color:
            rgba: color_bg
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        orientation: "vertical"
        padding: [dp(20), dp(20), dp(20), dp(16)]
        spacing: dp(14)

        BoxLayout:
            size_hint_y: None
            height: dp(44)
            spacing: dp(12)

            IconBtn:
                text: "‹"
                on_press: app.open_delivery_dashboard()

            TitleLabel:
                text: "Profile"

        ScrollView:
            do_scroll_x: False
            bar_width: dp(4)

            BoxLayout:
                orientation: "vertical"
                size_hint_y: None
                height: self.minimum_height
                spacing: dp(14)

                BoxLayout:
                    orientation: "vertical"
                    size_hint_y: None
                    height: dp(140)
                    padding: dp(24)

                    canvas.before:
                        Color:
                            rgba: color_primary
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [20]

                    Label:
                        text: "TOTAL INCOME"
                        font_size: 13
                        bold: True
                        color: (1, 1, 1, 0.85)
                        halign: 'left'
                        valign: 'top'
                        text_size: self.size
                        size_hint_y: None
                        height: dp(20)

                    Label:
                        id: income_label
                        text: "0.00€"
                        font_size: 42
                        bold: True
                        color: (1, 1, 1, 1)
                        halign: 'left'
                        valign: 'middle'
                        text_size: self.size

                    Label:
                        id: income_detail
                        text: ""
                        font_size: 13
                        color: (1, 1, 1, 0.85)
                        halign: 'left'
                        valign: 'bottom'
                        text_size: self.size
                        size_hint_y: None
                        height: dp(20)

                Card:
                    orientation: "vertical"
                    padding: dp(20)
                    spacing: dp(10)
                    size_hint_y: None
                    height: self.minimum_height

                    SubLabel:
                        text: "Register to a new restaurant"
                        size_hint_y: None
                        height: dp(20)

                    FieldInput:
                        id: code_input
                        hint_text: "Enter invite code"

                    Label:
                        id: msg_label
                        text: ""
                        font_size: 15
                        bold: True
                        size_hint_y: None
                        height: self.texture_size[1] if self.text else 0

                    ActionBtn:
                        text: "Add Restaurant"
                        btn_color: color_primary
                        on_press: app.redeem_restaurant_code(code_input.text)

                GhostBtn:
                    text: "Logout"
                    line_color: color_danger
                    on_press: app.logout()
