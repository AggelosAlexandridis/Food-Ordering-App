<DashboardScreen>:
    canvas.before:
        Color:
            rgba: color_bg
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        orientation: "vertical"
        padding: [dp(20), dp(20), dp(20), dp(16)]
        spacing: dp(16)

        BoxLayout:
            size_hint_y: None
            height: dp(44)
            spacing: dp(10)

            TitleLabel:
                text: "Discover"

            PillBtn:
                id: balance_btn
                text: "Balance"
                on_press: app.show_wallet()

            Label:
                id: profile_name_label
                text: ""
                font_size: 15
                bold: True
                color: color_text
                size_hint_x: None
                width: self.texture_size[0]
                halign: 'right'
                valign: 'middle'
                text_size: (None, self.height)

            ProfileIconBtn:
                on_press: app.open_profile_screen()

        SubLabel:
            text: "Restaurants near you"
            size_hint_y: None
            height: dp(22)

        RecycleView:
            id: rv
            viewclass: 'DashboardItem'

            RecycleBoxLayout:
                default_size: None, dp(78)
                default_size_hint: 1, None
                size_hint_y: None
                height: self.minimum_height
                spacing: dp(12)
                orientation: 'vertical'


<DashboardItem@ListCard>:
    accent: color_primary
    on_press: app.on_restaurant_press(self.id)

    Label:
        text: root.text
        font_size: 18
        bold: True
        color: color_text
        halign: 'left'
        valign: 'middle'
        text_size: self.size
        padding: [dp(12), 0]

    Label:
        text: "›"
        font_size: 24
        bold: True
        color: color_text_soft
        size_hint_x: None
        width: dp(24)
        halign: 'right'
        valign: 'middle'
        text_size: self.size