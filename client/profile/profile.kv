<ProfileScreen>:
    canvas.before:
        Color:
            rgba: color_bg
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        orientation: "vertical"
        padding: [dp(20), dp(20), dp(20), dp(16)]
        spacing: dp(14)

        BoxLayout:
            size_hint_y: None
            height: dp(44)
            spacing: dp(12)

            IconBtn:
                text: "‹"
                on_press: app.go_back_to_dashboard()

            TitleLabel:
                text: "Profile"

        ScrollView:
            do_scroll_x: False
            bar_width: dp(4)

            BoxLayout:
                orientation: "vertical"
                size_hint_y: None
                height: self.minimum_height
                spacing: dp(14)

                Card:
                    orientation: "vertical"
                    padding: dp(20)
                    spacing: dp(10)
                    size_hint_y: None
                    height: self.minimum_height

                    SubLabel:
                        id: username_label
                        text: "Signed in as"
                        size_hint_y: None
                        height: dp(20)

                    FieldInput:
                        id: name_input
                        hint_text: "Your name"

                    Label:
                        id: msg_label
                        text: ""
                        font_size: 15
                        bold: True
                        size_hint_y: None
                        height: self.texture_size[1] if self.text else 0

                    ActionBtn:
                        text: "Save Name"
                        btn_color: color_primary
                        on_press: app.save_profile_name(name_input.text)

                ListCard:
                    accent: color_primary
                    on_press: app.open_orders_screen()

                    Label:
                        text: "My Orders"
                        font_size: 17
                        bold: True
                        color: color_text
                        halign: 'left'
                        valign: 'middle'
                        text_size: self.size
                        padding: [dp(12), 0]

                    Label:
                        text: "›"
                        font_size: 24
                        bold: True
                        color: color_text_soft
                        size_hint_x: None
                        width: dp(24)
                        halign: 'right'
                        valign: 'middle'
                        text_size: self.size

                ListCard:
                    accent: color_warning
                    on_press: app.open_cards_screen()

                    Label:
                        text: "My Cards"
                        font_size: 17
                        bold: True
                        color: color_text
                        halign: 'left'
                        valign: 'middle'
                        text_size: self.size
                        padding: [dp(12), 0]

                    Label:
                        text: "›"
                        font_size: 24
                        bold: True
                        color: color_text_soft
                        size_hint_x: None
                        width: dp(24)
                        halign: 'right'
                        valign: 'middle'
                        text_size: self.size

                ListCard:
                    accent: color_success
                    on_press: app.open_address_screen()

                    Label:
                        text: "My Addresses"
                        font_size: 17
                        bold: True
                        color: color_text
                        halign: 'left'
                        valign: 'middle'
                        text_size: self.size
                        padding: [dp(12), 0]

                    Label:
                        text: "›"
                        font_size: 24
                        bold: True
                        color: color_text_soft
                        size_hint_x: None
                        width: dp(24)
                        halign: 'right'
                        valign: 'middle'
                        text_size: self.size

                GhostBtn:
                    text: "Logout"
                    line_color: color_danger
                    on_press: app.logout()
